{
  "buildCommand": "bunx vite build && node scripts/prerender.mjs",
  "outputDirectory": "dist",
  "installCommand": "bun install",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/apps",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/event-production",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/event-production/:path*",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/web-designer-grenoble",
      "destination": "/web-designer-annecy",
      "permanent": true
    },
    {
      "source": "/creation-site-web-grenoble",
      "destination": "/creation-site-web-haute-savoie",
      "permanent": true
    },
    {
      "source": "/web-designer-chambery",
      "destination": "/creation-site-web-chambery",
      "permanent": true
    },
    {
      "source": "/web-designer-albertville",
      "destination": "/creation-site-web-albertville",
      "permanent": true
    },
    {
      "source": "/web-designer-aix-les-bains",
      "destination": "/creation-site-web-aix-les-bains",
      "permanent": true
    },
    {
      "source": "/web-designer-moutiers",
      "destination": "/creation-site-web-moutiers",
      "permanent": true
    },
    {
      "source": "/creation-site-web-savoie",
      "destination": "/web-designer-savoie",
      "permanent": true
    },
    {
      "source": "/creation-site-web-annecy",
      "destination": "/web-designer-annecy",
      "permanent": true
    },
    {
      "source": "/a-propos-de-moi",
      "destination": "/a-propos",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/a-propos",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon\\.png|manifest\\.json|robots\\.txt|sitemap\\.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/blog/covers/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(llms\\.txt|llms-full\\.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
